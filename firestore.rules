rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: mccs
    // Fields: name (string), location (string), startupDate (string), status (string), manager (string), cashier (string)
    //
    // Collection: users
    // Fields: fullName (string), username (string), role (string), mccIds (list), status (string), phone (string), photo (string)
    //
    // Collection: sellers
    // Fields: name (string), phone (string), location (string), category (string), mccId (string), active (bool)
    //
    // Collection: daily_register
    // Fields: sellerId (string), mccId (string), date (string), quantity (number), unit (string), pricePerUnit (number), amount (number), status (string), remarks (string)
    //
    // Collection: expenses
    // Fields: mccId (string), date (string), description (string), receiptNo (string), quantity (number), amountPerUnit (number), total (number), approvedBy (string)
    //
    // Collection: money_received
    // Fields: mccId (string), sender (string), purpose (string), refNo (string), date (string), mode (string), amountReceived (number), amountUsed (number), balance (number), notes (string)
    //
    // Collection: milk_cans
    // Fields: mccId (string), sellerName (string), phone (string), capacity (string), quantity (number), dateIssued (string), status (string), issuedBy (string), remarks (string)
    //
    // Collection: rejects
    // Fields: sellerName (string), mccId (string), time (string), litersRejected (number), temp (number), phAcidity (string), rejectionReason (string), testCode (string), actionTaken (string), remarks (string), date (string)
    //
    // Collection: presence
    // Fields: uid (string), username (string), fullName (string), lastSeen (timestamp), status (string)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == "mtaniwambura@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'super user' ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roleOverride', '').lower() == 'admin') ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roleOverride', '').lower() == 'super user')
        ))
      );
    }

    function hasRole(role) {
      return isAuthenticated() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == role.lower() ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roleOverride', '').lower() == role.lower()
          )
        )
      );
    }

    function hasAnyRole(roles) {
      return isAuthenticated() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() in roles ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roleOverride', '').lower() in roles
          )
        )
      );
    }

    function isAssignedToMCC(mccId) {
      return isAuthenticated() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          mccId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mccIds || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() in ['viewer', 'supervisor', 'manager', 'director'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roleOverride', '').lower() in ['viewer', 'supervisor', 'manager', 'director']
        ))
      );
    }

    function isValidString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /mccs/{mccId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sellers/{sellerId} {
      allow read: if isAuthenticated();
      allow create, update: if hasAnyRole(['cashier', 'supervisor', 'quality controller', 'manager', 'director', 'admin', 'super user']);
      allow delete: if isAdmin();
    }

    match /daily_register/{entryId} {
      allow read: if isAuthenticated();
      allow create, update: if hasAnyRole(['cashier', 'grader', 'supervisor', 'quality controller', 'factory clerk', 'manager', 'director', 'admin', 'super user']);
      allow delete: if hasAnyRole(['cashier', 'grader', 'quality controller', 'factory clerk', 'admin', 'super user']);
    }

    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create, update: if hasAnyRole(['cashier', 'supervisor', 'admin', 'super user', 'manager', 'director']);
      allow delete: if isAdmin();
    }

    match /money_received/{mrId} {
      allow read: if isAuthenticated();
      allow create, update: if hasAnyRole(['cashier', 'grader', 'quality controller', 'supervisor', 'admin', 'super user', 'manager', 'director']);
      allow delete: if isAdmin();
    }

    match /truck_qa/{qaId} {
      allow read: if isAuthenticated();
      allow create, update: if hasAnyRole(['grader', 'supervisor', 'factory clerk', 'quality controller', 'admin', 'super user', 'manager', 'director']);
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /milk_cans/{canId} {
      allow read: if isAuthenticated();
      allow create, update: if hasAnyRole(['cashier', 'grader', 'supervisor', 'quality controller', 'admin', 'super user']);
      allow delete: if isAdmin();
    }

    match /milk_can_inventory/{inventoryId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['cashier', 'supervisor', 'grader', 'quality controller', 'admin', 'super user']);
    }

    match /rejects/{rejectId} {
      allow read: if isAuthenticated();
      allow create, update: if hasAnyRole(['grader', 'cashier', 'supervisor', 'quality controller', 'factory clerk', 'manager', 'director', 'admin', 'super user']);
      allow delete: if isAdmin();
    }

    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isValidReceipt(data) {
      return data.keys().hasAll(['fileName', 'mimeType', 'size', 'chunkCount', 'parentCollection', 'createdAt']) &&
        data.keys().hasOnly(['fileName', 'mimeType', 'size', 'chunkCount', 'data', 'parentCollection', 'uploadedBy', 'createdAt']) &&
        isValidString(data.fileName, 1, 255) &&
        isValidString(data.mimeType, 1, 100) &&
        data.size is number && data.size > 0 && data.size <= 5242880 &&
        data.chunkCount is number && data.chunkCount >= 0 && data.chunkCount <= 20 &&
        data.parentCollection in ['expenses', 'money_received'] &&
        isValidString(data.createdAt, 1, 64) &&
        (!('data' in data) || (data.data is string && data.data.size() <= 900000)) &&
        (!('uploadedBy' in data) || isValidString(data.uploadedBy, 0, 200));
    }

    match /receipts/{receiptId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['cashier', 'grader', 'quality controller', 'supervisor', 'factory clerk', 'admin', 'super user', 'manager', 'director']) &&
        isValidId(receiptId) &&
        isValidReceipt(request.resource.data);
      allow update: if hasAnyRole(['cashier', 'grader', 'quality controller', 'supervisor', 'factory clerk', 'admin', 'super user', 'manager', 'director']) &&
        isValidId(receiptId) &&
        isValidReceipt(request.resource.data);
      allow delete: if hasAnyRole(['cashier', 'grader', 'quality controller', 'supervisor', 'factory clerk', 'admin', 'super user', 'manager', 'director']);

      match /chunks/{chunkId} {
        allow read: if isAuthenticated();
        allow create, update: if hasAnyRole(['cashier', 'grader', 'quality controller', 'supervisor', 'factory clerk', 'admin', 'super user', 'manager', 'director']) &&
          request.resource.data.keys().hasAll(['index', 'data']) &&
          request.resource.data.keys().hasOnly(['index', 'data']) &&
          request.resource.data.index is number &&
          request.resource.data.data is string &&
          request.resource.data.data.size() <= 900000;
        allow delete: if hasAnyRole(['cashier', 'grader', 'quality controller', 'supervisor', 'factory clerk', 'admin', 'super user', 'manager', 'director']);
      }
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
